# OnMyCompany local env example
# Copy to .env and fill in. Do not commit real secrets.

# --- HTTP ---
PORT=3100
HOST=127.0.0.1

# Public origin for OAuth redirects
OMC_ORIGIN=http://127.0.0.1:3100

# SQLite + transit files
OMC_DATA_DIR=./data

# Encrypt credentials (required for any serious deploy)
# OMC_ENCRYPTION_KEY=

# Ops-admin bearer for /api admin surfaces, docs, console (when enforced)
# OMC_ADMIN_TOKEN=

# Optional bootstrap runtime token for /v1 and MCP
# OMC_RUNTIME_TOKEN=

# Tighten executable surface (comma-separated; supports service.* and *)
# OMC_ALLOWED_ACTIONS=hackernews.*,github.get_current_user
# OMC_BLOCKED_ACTIONS=
# OMC_ALLOWED_PROXIES=
# OMC_BLOCKED_PROXIES=

# Private network targets for self-hosted providers (Node/Docker only)
# OMC_ALLOW_PRIVATE_NETWORK=false

OMC_LOG_LEVEL=info

# --- OnMyCompany identity (MVP) ---
OMC_BOOTSTRAP_ADMIN_EMAIL=admin@company.internal
# Fixed OTP for local/dev (no SMTP). Returned as devCode on email/start.
OMC_DEV_OTP=000000

# Catalog surface in console (default: office ~70 apps: collab + CN + AI + no_auth).
# OMC_CATALOG_PROFILE=office
# OMC_CATALOG_PROFILE=full
# Or explicit list (overrides profile):
# OMC_ALLOWED_SERVICES=gmail,notion,slack,github,feishu,hackernews,qq_mail
# OMC_ALLOWED_SERVICES=*

# G0 concurrency caps (execution paths → 429 when exceeded)
# OMC_MAX_IN_FLIGHT=100
# OMC_MAX_IN_FLIGHT_PER_MEMBER=10

# --- OmniRoute sidecar (B+D: model plane, process-isolated) ---
# Chat → OmniRoute; tools → this OMC process. See docs/onmycompany/OMNIROUTE-SIDECAR.md
# OMC_OMNIROUTE_URL=http://127.0.0.1:20128
# OMC_OMNIROUTE_V1=http://127.0.0.1:20128/v1
# OMC_OMNIROUTE_DASHBOARD_URL=http://127.0.0.1:20128/dashboard
# Optional: Bearer for OmniRoute /api/pricing if it requires auth
# OMC_OMNIROUTE_ADMIN_KEY=
# OMC_OMNIROUTE_PRICING_PATH=/api/pricing
# OMC_OMNIROUTE_USAGE_PATH=/api/usage/history
# Pricing source for GET /api/company/pricing: auto | omniroute | static
# OMC_PRICING_SOURCE=auto
# Set 0/false to force static LLM prices
# OMC_OMNIROUTE_PRICING=1
# npm run dev:omniroute   OR   npm run omniroute:up
